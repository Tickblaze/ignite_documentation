{
  "name": "ignite-api-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "next dev",
    "predev": "npm run generate:api",
    "build": "next build",
    "prebuild": "npm run generate:api",
    "start": "next start",
    "generate:api": "node --import tsx scripts/generate-api.ts",
    "postinstall": "npm run generate:api && fumadocs-mdx",
    "typecheck": "npm run generate:api && fumadocs-mdx && tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "16.17.2",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-openapi": "12.4.2",
    "fumadocs-ui": "16.17.2",
    "next": "16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shiki": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
